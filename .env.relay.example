RUST_LOG=info
# Public UDP listener. Use one relay instance per public port when SO_REUSEPORT
# fan-out is not managed by a process supervisor.
RELAY_BIND=0.0.0.0:5521
# The selected regional game gateway or local WireGuard/NAT endpoint.
RELAY_UPSTREAM=203.0.113.10:10000
RELAY_SESSION_TIMEOUT_SECS=60
RELAY_SOCKET_BUFFER=4194304
