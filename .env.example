PORT=8080
BOT_TOKEN=123456:ABC...
DATABASE_URL=postgres://user:pass@host:5432/gameboost
DATABASE_SSL=false
# Public HTTPS origin (TLS terminated by Railway / Caddy / nginx). No trailing slash.
BASE_URL=https://dns.yourdomain.com
# Leave WEBHOOK_URL empty to use long polling.
WEBHOOK_URL=
WEBHOOK_SECRET=
ADMIN_IDS=111111111
ADMIN_TOKEN=replace-with-a-long-random-admin-token
SUPPORT_HANDLE=@youradmin
TRIAL_HOURS=5
DEVICE_SWITCH_SECONDS=120
LOG_ALL_QUERIES=false
LOG_RETENTION_DAYS=7
# Routing rules: file path OR inline JSON (handy on Railway). See routing.example.json
ROUTING_FILE=routing.json
# ROUTING_JSON=[{"domain":"...","ips":["..."]}]
